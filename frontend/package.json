    "dayjs": "^1.11.13",
    "next": "14.2.24",
    "normalize.css": "^8.0.1",
    "react": "^18.3.1",
    "react-circular-progressbar": "^2.1.0",
    "react-dom": "^18.3.1",
    "react-jss": "^10.10.0",
    "react-markdown": "^9.0.1",
    "react-tooltip": "^5.28.0",
