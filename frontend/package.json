  "license": "GNU GPLv3",
  "scripts": {
    "clean": "node -e \"require('fs').rmSync('.next', { recursive: true, force: true })\"",
    "predev": "node -e \"require('fs').rmSync('.next', { recursive: true, force: true })\"",
    "dev": "next dev -H 127.0.0.1 -p 3000",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:update": "jest -u",
    "progress": "ts-node -O '{\"module\":\"commonjs\"}' scripts/updateProgress.ts"
  },
